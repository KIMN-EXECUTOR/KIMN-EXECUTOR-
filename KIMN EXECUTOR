--------------------------------------------------------------------------------
-- 3. ANIMATION SEQUENCE (Intro Fade In/Out -> Key Box Slide In)
--------------------------------------------------------------------------------
task.spawn(function()
    local tweenInfoFadeIn = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tweenInfoFadeOut = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    -- Step 1: Fade In Intro Text
    TweenService:Create(IntroText, tweenInfoFadeIn, {TextTransparency = 0}):Play()
    TweenService:Create(IntroShadow, tweenInfoFadeIn, {TextTransparency = 0}):Play()
    task.wait(1.4)

    -- Step 2: Fade Out Intro Text
    TweenService:Create(IntroText, tweenInfoFadeOut, {TextTransparency = 1}):Play()
    TweenService:Create(IntroShadow, tweenInfoFadeOut, {TextTransparency = 1}):Play()
    task.wait(0.7)
    IntroHolder:Destroy()

    -- Step 3: Slide & Fade In Main Key Box
    MainFrame.Position = UDim2.new(1, 40, 0.5, -112)
    
    local boxTweenInfo = TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    
    TweenService:Create(MainFrame, boxTweenInfo, {
        Position = UDim2.new(0.97, -310, 0.5, -112),
        BackgroundTransparency = 0
    }):Play()
    
    TweenService:Create(MainStroke, boxTweenInfo, {Transparency = 0}):Play()
    TweenService:Create(TitleLabel, boxTweenInfo, {TextTransparency = 0}):Play()
    TweenService:Create(KeyInput, boxTweenInfo, {BackgroundTransparency = 0, TextTransparency = 0, PlaceholderColor3 = Color3.fromRGB(130, 130, 130)}):Play()
    TweenService:Create(InputStroke, boxTweenInfo, {Transparency = 0}):Play()
    TweenService:Create(StatusLabel, boxTweenInfo, {TextTransparency = 0}):Play()
    TweenService:Create(SubmitBtn, boxTweenInfo, {BackgroundTransparency = 0, TextTransparency = 0}):Play()
    TweenService:Create(SubmitStroke, boxTweenInfo, {Transparency = 0}):Play()
    TweenService:Create(CopyLinkBtn, boxTweenInfo, {BackgroundTransparency = 0, TextTransparency = 0}):Play()
    TweenService:Create(CopyLinkStroke, boxTweenInfo, {Transparency = 0}):Play()
    TweenService:Create(CloseBtn, boxTweenInfo, {BackgroundTransparency = 0, TextTransparency = 0}):Play()
end)

