    else
        StatusLabel.TextColor3 = Color3.fromRGB(235, 190, 75)
        StatusLabel.Text = "Clipboard not supported on this client."
    end
end)

SubmitBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == VALID_KEY then
        StatusLabel.TextColor3 = Color3.fromRGB(100, 210, 130)
        StatusLabel.Text = "Key verified! Loading Kimn Executor..."
        task.wait(0.8)
        ScreenGui:Destroy()
        
